# Copy this file to .env.local and fill in values from your Supabase project.
# Never commit real credentials.

# Public Supabase settings (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy alias supported by the app: NEXT_PUBLIC_SUPABASE_ANON_KEY

# Server-only. Never expose this key to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public URL used for auth redirects and certificate links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: used only by `pnpm supabase:push` and `pnpm supabase:types` to apply
# migrations and generate types. Get it from Supabase Dashboard -> Connect.
# Never expose this connection string to the browser.
# SUPABASE_DB_URL=
